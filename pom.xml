<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.akine</groupId>
	<artifactId>akine-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>akine-api</name>
	<description>AKINE backend - SaaS multi-tenant para centros de kinesiologia, fisioterapia y rehabilitacion</description>

	<properties>
		<java.version>21</java.version>
		<archunit.version>1.5.1</archunit.version>
		<springdoc.version>3.1.1</springdoc.version>
		<jacoco.version>0.8.15</jacoco.version>
		<maven-enforcer.version>3.6.3</maven-enforcer.version>
		<bouncycastle.version>1.86</bouncycastle.version>
		<greenmail.version>2.1.14</greenmail.version>
		<dependency-check.version>12.2.2</dependency-check.version>
		<!-- Parches de seguridad por encima de lo que gestiona Spring Boot 4.1.1 (G-6, 09/10/2026).
		     Tomcat 11.0.24: tres CVE criticos (CVE-2026-65905, -65182, -68525), corregidos en
		     11.0.25. Jackson 3.1.5 / 2.21.5: altas en databind y core (CVE-2026-68497, -91776,
		     -91777, -89425, -89407), corregidas en 3.1.7 / 2.21.7. Son parches de la misma
		     linea: BORRAR estas tres propiedades cuando el parent de Spring Boot traiga
		     versiones iguales o mayores, o quedan fijando una version vieja. -->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
		<!-- Connector/J BAJADO a 9.6.0 (U-05, decidido por el usuario el 17/10/2026). Spring Boot
		     4.1.1 gestiona 9.7.0, afectada por CVE-2026-60586 (7.7), -60623 (7.1), -60624 y -61082
		     (6.5): Oracle declara afectadas 9.7.0-9.7.1 y no hay 9.7.x ni 9.8 corregida en Maven Central.
		     NVD no registra ningun CVE para 9.6.0. La linea sucesora 26.7.0 (24/07/2026) tampoco figura
		     afectada, pero es un salto de linea que el usuario no autorizo. BORRAR esta propiedad cuando
		     el parent traiga una version corregida, o queda fijando una version vieja. -->
		<mysql.version>9.6.0</mysql.version>
		<!-- Version SemVer del contrato OpenAPI publicado. Se sube a mano en la etapa
		     que cambie la API: minor para cambios aditivos, major para incompatibles. -->
		<akine.contract.version>0.134.0</akine.contract.version>
	</properties>

	<dependencies>
		<!-- ===== Web / API ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- ===== Persistencia ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== Seguridad =====
		     En AKINE-00.01 solo aporta headers seguros y una cadena permisiva explicita.
		     Identidad, tenant y permisos se implementan en F1 (M01-M02). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Argon2id para el hashing de contrasenas (AKINE-01.02).
		     Argon2PasswordEncoder de Spring Security delega en BouncyCastle y NO lo arrastra:
		     sin esta dependencia el encoder lanza NoClassDefFoundError al primer registro real.
		     Argon2id es memory-hard; el fallback PBKDF2 no lo es, asi que no son equivalentes. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>${bouncycastle.version}</version>
		</dependency>

		<!-- ===== Correo saliente (AKINE-01.02b) =====
		     Aporta spring-context-support (JavaMailSender), jakarta.mail-api y la
		     implementacion Angus. Sin esto SmtpEmailSender no puede existir y el unico
		     adaptador disponible es el de log, que no envia nada: ADR-0018 apoya su 202
		     uniforme en que el usuario legitimo llegue a destino por este canal. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- ===== Observabilidad ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Metricas en formato Prometheus, servidas en /actuator/prometheus (G-4). La exposicion
		     y quien puede leerlas las decide application.yml + SecurityConfig; ver
		     docs/observabilidad.md. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Trazas (G-4): Micrometer Tracing con el puente a OpenTelemetry y el exportador OTLP.
		     Se usan los modulos sueltos y NO spring-boot-starter-opentelemetry porque el starter
		     trae tambien micrometer-registry-otlp, que empuja METRICAS por OTLP a
		     localhost:4318 cada minuto y llena el log de errores donde no hay collector. Las
		     metricas salen por Prometheus; por OTLP solo salen las trazas, y solo si se
		     configura un endpoint (ver docs/observabilidad.md). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== Test ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Servidor SMTP en proceso para el test que verifica que el correo LLEGA de verdad.
		     No alcanza con afirmar que el adaptador no explota: lo que hay que probar es que
		     del otro lado aparece un mensaje con destinatario, asunto y cuerpo. -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail-junit5</artifactId>
			<version>${greenmail.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Reglas de arquitectura del monolito modular. Ver AGENT.md seccion 4. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- SBOM CycloneDX (G-3). Version y ejecucion las administra el parent de Spring
			     Boot: makeAggregateBom en generate-resources, JSON, sin dependencias de test,
			     escrito en target/classes/META-INF/sbom/application.cdx.json. Como corre antes
			     de package, el SBOM queda ademas EMBEBIDO en el jar y por lo tanto en la imagen
			     Docker. El CI lo publica como artifact.
			     OJO: el goal exige modo online. Con `./mvnw -o` se SALTEA con un WARNING (no
			     falla) y target/classes conserva el SBOM de la ultima corrida online, si la hubo. -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>

			<!-- Tests unitarios y de arquitectura. -->
			<!-- Vulnerabilidades conocidas de las dependencias (AKINE G-6).
			     No esta enganchado a ninguna fase: corre en su propio job del CI con
			     `./mvnw dependency-check:check`, porque bajar la base del NVD tarda y no tiene
			     por que frenar cada `verify` local.
			     Falla SOLO con CVSS >= 7 (alta o critica): lo de abajo queda en el reporte, que
			     el CI publica siempre, pero no frena el merge. Un falso positivo se silencia en
			     dependency-check-suppressions.xml con su motivo, nunca bajando el umbral. -->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>${dependency-check.version}</version>
				<configuration>
					<failBuildOnCVSS>7</failBuildOnCVSS>
					<formats>
						<format>HTML</format>
						<format>JSON</format>
					</formats>
					<outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
					<!-- Fuera de ~/.m2 para que la cache de Maven del CI no arrastre los ~250 MB del NVD. -->
					<dataDirectory>${user.home}/.cache/dependency-check</dataDirectory>
					<suppressionFiles>
						<suppressionFile>${project.basedir}/dependency-check-suppressions.xml</suppressionFile>
					</suppressionFiles>
					<!-- La clave del NVD NO va aca: el CI la pasa con -DnvdApiKey solo si el secreto
					     NVD_API_KEY existe. Fijada en 12.2.x a proposito: la 13.0.0 sin clave muere con
					     "Invalid API Key, length of 0" en vez de esperar el limite del NVD. -->
					<!-- OSS Index exige cuenta desde 2025; sin credenciales sus 401 tumban la corrida. -->
					<ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
					<!-- Analizadores de otros ecosistemas: el backend es solo Java. -->
					<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
					<nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
					<nodeAuditAnalyzerEnabled>false</nodeAuditAnalyzerEnabled>
					<retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
					<nuspecAnalyzerEnabled>false</nuspecAnalyzerEnabled>
					<nugetconfAnalyzerEnabled>false</nugetconfAnalyzerEnabled>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Tests de integracion (*IT). Requieren Docker corriendo (Testcontainers). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Reproducibilidad del build: fija las versiones de runtime y detecta
			     conflictos de dependencias antes de que se manifiesten en ejecucion. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer.version}</version>
				<executions>
					<execution>
						<id>enforce-build-reproducible</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<!-- Java 21 exacto: compilar con 22+ y desplegar en 21 produce
									     UnsupportedClassVersionError recien en runtime. -->
									<version>[21,22)</version>
									<message>AKINE requiere Java 21. Ver docs/ai-setup.md.</message>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9.0,)</version>
								</requireMavenVersion>
								<dependencyConvergence/>
								<banDuplicatePomDependencyVersions/>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Cobertura con umbral activo (AKINE-00.02).
			     El plan exige >=80% en codigo nuevo y >=90% en modulos criticos.
			     El baseline mide 98%: el umbral es un piso, no una meta. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<!-- main() de Spring Boot: arranque, sin logica que probar. -->
						<exclude>**/AkineApiApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.80</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<!-- Trinquete por modulo critico (AKINE G-6, medido el 11/10/2026 en el CI
					     sobre main 955855f + esta rama, con verify completo).

					     Cada ejecucion mide el AGREGADO de un modulo (com/akine/<modulo>/**) y no
					     cada paquete Java por separado: el elemento PACKAGE de JaCoCo exige el minimo
					     a CADA paquete, y billing.api.dto (0 %) o scheduling.api.dto (20 %) dejarian
					     la regla del modulo en un numero que no protege nada.

					     El minimo es lo medido redondeado hacia abajo al punto entero: cualquier
					     cambio que baje la cobertura de un modulo critico rompe el build. La meta del
					     plan es 0,90 y desde akine-cobertura-capa-rest (slices de la capa REST de
					     billing, person, scheduling y clinical) los siete la pasan; numeros en
					     docs/calidad.md §4. Unica excepcion al redondeo: la instruccion de identity
					     queda en 0,97 y no en 0,98, porque 98,19 % dejaria 0,19 puntos de margen y
					     un IT concurrente lo mueve mas que eso. Se suben a mano cuando la cobertura
					     sube, nunca se bajan para hacer pasar un PR. -->
					<execution>
						<id>check-coverage-identity</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/identity/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.97</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.97</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-organization</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/organization/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.97</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.97</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-billing</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/billing/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.96</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.96</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-clinical</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/clinical/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.91</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.91</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-encounter</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/encounter/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.94</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.93</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-person</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/person/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.92</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.92</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
					<execution>
						<id>check-coverage-scheduling</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/akine/scheduling/**</include>
							</includes>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.93</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.93</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
