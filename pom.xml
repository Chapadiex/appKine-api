<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.akine</groupId>
	<artifactId>akine-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>akine-api</name>
	<description>AKINE backend - SaaS multi-tenant para centros de kinesiologia, fisioterapia y rehabilitacion</description>

	<properties>
		<java.version>21</java.version>
		<archunit.version>1.4.1</archunit.version>
		<springdoc.version>3.1.0</springdoc.version>
		<jacoco.version>0.8.13</jacoco.version>
		<maven-enforcer.version>3.6.2</maven-enforcer.version>
		<bouncycastle.version>1.85.2</bouncycastle.version>
		<greenmail.version>2.1.9</greenmail.version>
		<!-- Version SemVer del contrato OpenAPI publicado. Se sube a mano en la etapa
		     que cambie la API: minor para cambios aditivos, major para incompatibles. -->
		<akine.contract.version>0.55.0</akine.contract.version>
	</properties>

	<dependencies>
		<!-- ===== Web / API ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- ===== Persistencia ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ===== Seguridad =====
		     En AKINE-00.01 solo aporta headers seguros y una cadena permisiva explicita.
		     Identidad, tenant y permisos se implementan en F1 (M01-M02). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Argon2id para el hashing de contrasenas (AKINE-01.02).
		     Argon2PasswordEncoder de Spring Security delega en BouncyCastle y NO lo arrastra:
		     sin esta dependencia el encoder lanza NoClassDefFoundError al primer registro real.
		     Argon2id es memory-hard; el fallback PBKDF2 no lo es, asi que no son equivalentes. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcprov-jdk18on</artifactId>
			<version>${bouncycastle.version}</version>
		</dependency>

		<!-- ===== Correo saliente (AKINE-01.02b) =====
		     Aporta spring-context-support (JavaMailSender), jakarta.mail-api y la
		     implementacion Angus. Sin esto SmtpEmailSender no puede existir y el unico
		     adaptador disponible es el de log, que no envia nada: ADR-0018 apoya su 202
		     uniforme en que el usuario legitimo llegue a destino por este canal. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>

		<!-- ===== Observabilidad ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- ===== Test ===== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Servidor SMTP en proceso para el test que verifica que el correo LLEGA de verdad.
		     No alcanza con afirmar que el adaptador no explota: lo que hay que probar es que
		     del otro lado aparece un mensaje con destinatario, asunto y cuerpo. -->
		<dependency>
			<groupId>com.icegreen</groupId>
			<artifactId>greenmail-junit5</artifactId>
			<version>${greenmail.version}</version>
			<scope>test</scope>
		</dependency>

		<!-- Reglas de arquitectura del monolito modular. Ver AGENT.md seccion 4. -->
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit-junit5</artifactId>
			<version>${archunit.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!-- SBOM CycloneDX (G-3). Version y ejecucion las administra el parent de Spring
			     Boot: makeAggregateBom en generate-resources, JSON, sin dependencias de test,
			     escrito en target/classes/META-INF/sbom/application.cdx.json. Como corre antes
			     de package, el SBOM queda ademas EMBEBIDO en el jar y por lo tanto en la imagen
			     Docker. El CI lo publica como artifact.
			     OJO: el goal exige modo online. Con `./mvnw -o` se SALTEA con un WARNING (no
			     falla) y target/classes conserva el SBOM de la ultima corrida online, si la hubo. -->
			<plugin>
				<groupId>org.cyclonedx</groupId>
				<artifactId>cyclonedx-maven-plugin</artifactId>
			</plugin>

			<!-- Tests unitarios y de arquitectura. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/*IT.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<!-- Tests de integracion (*IT). Requieren Docker corriendo (Testcontainers). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Reproducibilidad del build: fija las versiones de runtime y detecta
			     conflictos de dependencias antes de que se manifiesten en ejecucion. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<version>${maven-enforcer.version}</version>
				<executions>
					<execution>
						<id>enforce-build-reproducible</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<!-- Java 21 exacto: compilar con 22+ y desplegar en 21 produce
									     UnsupportedClassVersionError recien en runtime. -->
									<version>[21,22)</version>
									<message>AKINE requiere Java 21. Ver docs/ai-setup.md.</message>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>[3.9.0,)</version>
								</requireMavenVersion>
								<dependencyConvergence/>
								<banDuplicatePomDependencyVersions/>
							</rules>
							<fail>true</fail>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Cobertura con umbral activo (AKINE-00.02).
			     El plan exige >=80% en codigo nuevo y >=90% en modulos criticos.
			     El baseline mide 98%: el umbral es un piso, no una meta. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<configuration>
					<excludes>
						<!-- main() de Spring Boot: arranque, sin logica que probar. -->
						<exclude>**/AkineApiApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
					<execution>
						<id>check-coverage</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.73</minimum>
										</limit>
										<limit>
											<counter>INSTRUCTION</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.71</minimum>
										</limit>
									</limits>
								</rule>
								<!-- PENDIENTE(F1): al crear identity, organization, clinical y
								     billing, agregar aqui reglas PACKAGE al 0.90 para esos
								     modulos criticos. Hoy no existen y una regla sobre un
								     paquete inexistente no verifica nada. -->
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
