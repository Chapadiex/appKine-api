   "id": "howto_h",
   "x": 40,
   "y": 112,
   "width": 105.6,
   "height": 20,
   "text": "CÓMO SE LEE",
   "originalText": "CÓMO SE LEE",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#3b82f6",
   "backgroundColor": "transparent",
   "containerId": null,
