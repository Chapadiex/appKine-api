   "baseline": 14
  },
  {
   "angle": 0,
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 1007,
   "version": 1,
   "versionNonce": 1008,
